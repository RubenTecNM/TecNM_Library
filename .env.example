# ==============================================================================
# Variables de entorno — Sistema de Biblioteca TecNM Campus Monclova
# Copia este archivo a `.env` (ignorado por Git) y define tus valores locales.
# ==============================================================================

COMPOSE_PROJECT_NAME=tecnm-library

# Puertos de la plataforma
TECNM_FRONTEND_PORT=6050
TECNM_BACKEND_PORT=6060

# Base de datos PostgreSQL (definir contraseña obligatoria en tu .env local)
POSTGRES_DB=tecnm_library
POSTGRES_USER=tecnm_admin
POSTGRES_PASSWORD=

# Backend .NET 10
ASPNETCORE_ENVIRONMENT=Development
CORS_ALLOWED_ORIGINS=http://localhost:6050,http://127.0.0.1:6050
